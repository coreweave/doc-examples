[
  {
    "Sid": "AllowCatalogInventoryList",
    "Effect": "Allow",
    "Principal": {
      "CW": "arn:aws:iam::[READER-ORG-ID]:coreweave/[REPORT-READER-PRINCIPAL-ID]"
    },
    "Action": ["s3:ListBucket"],
    "Resource": ["arn:aws:s3:::[DESTINATION-BUCKET]"]
  },
  {
    "Sid": "AllowCatalogInventoryRead",
    "Effect": "Allow",
    "Principal": {
      "CW": "arn:aws:iam::[READER-ORG-ID]:coreweave/[REPORT-READER-PRINCIPAL-ID]"
    },
    "Action": ["s3:GetObject"],
    "Resource": ["arn:aws:s3:::[DESTINATION-BUCKET]/inventory/*"]
  }
]
